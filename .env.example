# Copy to backend/.env and fill in. NEVER commit the real file.

# simulation (default; offline; clearly labelled, not real PayPal) | sandbox (official PayPal sandbox API)
PAYPAL_MODE=simulation

# Sandbox credentials: https://developer.paypal.com/dashboard/applications/sandbox -> create an app -> Client ID / Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID: same app page -> Add Webhook (URL: https://<your-public-host>/api/webhooks/paypal;
# events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.DENIED, CHECKOUT.PAYMENT-APPROVAL.REVERSED) -> copy the Webhook ID
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Live PayPal is refused unless this is explicitly true. Leave false for the hackathon.
ALLOW_LIVE_PAYMENTS=false

# REQUIRED to be changed in sandbox mode (startup refuses default keys)
OWNER_API_KEY=change-me-owner
AGENT_API_KEY=change-me-agent
SIM_WEBHOOK_SECRET=change-me-simulator

DATABASE_URL=sqlite:///./mandateguard.db
# PostgreSQL example (also: pip install psycopg[binary]):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/mandateguard
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Optional LLM planner. Without a key the local TF-IDF planner is used. Check current model names/pricing in Anthropic docs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_DAILY_CALL_BUDGET=50
RATE_LIMIT_PER_MINUTE=120
